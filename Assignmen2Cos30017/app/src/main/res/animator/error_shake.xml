<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="sequentially">
    <objectAnimator
        android:duration="80"
        android:propertyName="translationX"
        android:valueTo="-12"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="80"
        android:propertyName="translationX"
        android:valueTo="12"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="80"
        android:propertyName="translationX"
        android:valueTo="-8"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="80"
        android:propertyName="translationX"
        android:valueTo="8"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="80"
        android:propertyName="translationX"
        android:valueTo="0"
        android:valueType="floatType" />
</set>
