<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBooked"
    android:layout_width="150dp"
    android:layout_height="210dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Car image with "Booked" badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="110dp">

            <ImageView
                android:id="@+id/imgBookedCar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/content_description_car_image"
                android:scaleType="centerCrop" />

            <!-- Booked badge top-left -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="#CC1B5E20"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="✓ Booked"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Car details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvBookedCarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CarCardTextPrimary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Car Name" />

            <TextView
                android:id="@+id/tvBookedCarModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CarCardTextSecondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:text="Model" />

            <TextView
                android:id="@+id/tvBookedPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/PriceTag"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:text="100 credits/day" />

            <!-- Cancel button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelBooking"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:text="@string/cancel_booking"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/error_color"
                android:textColor="@color/error_color" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
