<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardFavourite"
    android:layout_width="150dp"
    android:layout_height="200dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Car image with favourite overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="110dp">

            <ImageView
                android:id="@+id/imgFavCar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/content_description_car_image"
                android:scaleType="centerCrop" />

            <ImageButton
                android:id="@+id/btnFavouriteFav"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_favourite_btn"
                android:contentDescription="@string/content_description_favourite"
                android:src="@drawable/ic_favorite"
                app:tint="@color/favourite_active" />

        </FrameLayout>

        <!-- Car details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvFavCarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CarCardTextPrimary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="BMW 3 Series" />

            <TextView
                android:id="@+id/tvFavCarModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/CarCardTextSecondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="M Sport Edition" />

            <TextView
                android:id="@+id/tvFavPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                style="@style/PriceTag"
                android:textSize="12sp"
                android:text="75 credits/day" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
